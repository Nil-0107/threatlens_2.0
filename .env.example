# ThreatLens Environment Configuration Template
APP_NAME=ThreatLens
APP_ENV=development
API_PREFIX=/api
DEBUG=True

# Database (SQLite default for hackathon, pluggable to postgresql://user:pass@host/threatlens)
DATABASE_URL=sqlite:///./threatlens.db

# Security & JWT
SECRET_KEY=threatlens-secret-key-36hour-hackathon-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Retention & Data Governance
DEFAULT_RETENTION_DAYS=90
ENABLE_PII_MASKING_BY_DEFAULT=False

# IP Geolocation & Live APIs
ENABLE_LIVE_GEO_FALLBACK=True
GEO_API_TIMEOUT=3.0

# External API Integrations (Optional)
VITE_CARTO_API_KEY=your_carto_basemaps_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
